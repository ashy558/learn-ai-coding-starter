{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "compaction": {
    "auto": true,
    "keep": { "tokens": 10000 },
    "buffer": 20000,
  },
  "watcher": {
    "ignore": ["logs/**"],
  },
  "permissions": [
    { "action": "run_slop", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "bootdev run *", "effect": "allow" },
    { "action": "shell", "resource": "bootdev submit *", "effect": "allow" },
    { "action": "shell", "resource": "uv run pytest *", "effect": "allow" },
    { "action": "shell", "resource": "uv run ruff *", "effect": "allow" },
    { "action": "shell", "resource": "uv run ty *", "effect": "allow" },
    { "action": "shell", "resource": "printf 'y\n' | bootdev submit", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
  ],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "disabled": true,
        "command": [
          "bunx",
          "--bun",
          "@playwright/mcp@0.0.80",
          "--isolated",
          "--browser",
          "chromium",
        ],
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "--bun",
          "chrome-devtools-mcp@latest",
          "--executablePath=/usr/bin/chromium",
          "--isolated",
        ],
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "enabled": false,
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "enabled": false,
      },
    }
  },
}
